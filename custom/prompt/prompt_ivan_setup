# Load dependencies
pmodload 'helper'  # needed for 'coalesce' function
zmodload zsh/datetime  # needed for EPOCHREALTIME

# Script variables
# holds the timer since the command was executed
_prompt_ivan_timer=""
# here we store the formatted elapsed time, for RPROMPT
# _prompt_ivan_timeprompt=""
# note: maybe use $psvar ?

function prompt_ivan_preexec() {
  _prompt_ivan_timer=$EPOCHREALTIME
}

# from https://gist.github.com/knadh/123bca5cfdae8645db750bfb49cb44b0?permalink_comment_id=4502423#gistcomment-4502423
# TODO: replace this for the ./format_time.zsh function, extracted to add test suite
function _prompt_ivan_format_time() {
    # TODO: check decimal rounding
    local time_in_ms=$1

    local d_s=$((time_in_ms / 1000))
    local ms=$((time_in_ms % 1000))
    local s=$((d_s % 60))
    local m=$(((d_s / 60) % 60))
    local h=$((d_s / 3600))

    local timeprompt=""

    if   ((h > 0)); then timeprompt=${h}h${m}m${s}s  # 1h23m45s
    elif ((m > 0)); then timeprompt=${m}m${s}.$(printf $(($ms / 100)))s  # 1m12.3s
    elif ((s > 9)); then timeprompt=${s}.$(printf %02d $(($ms / 10)))s  # 12.34s
    elif ((s > 0)); then timeprompt=${s}.$(printf %03d $ms)s  # 1.234s
    else timeprompt=${ms}ms  # 234ms
    fi

    echo "$timeprompt"
}

# optional signal name for some exit codes
function _exit_code_name {
  local exitstatus=$1
  [[ $exitstatus == 0 ]] && return
  [[ $exitstatus -lt 128 ]] && return;
  echo " (SIG$signals[$exitstatus-127])"
}

# optional signal name for some exit codes
function prompt_ivan_exit_code {
  local exitstatus=$?
  psvar[12]=""
  [[ $exitstatus -eq 0 ]] && return
  local signal=$(_exit_code_name $exitstatus)
  psvar[12]="[exit code: ${exitstatus}${signal}]"
}


# get execution time from last command
function prompt_ivan_timer {
  psvar[11]=""
  if [[ -n $_prompt_ivan_timer ]]; then
    # local -i makes elapsed_ms an integer automatically, truncating the float.
    local -i elapsed_ms=$(( (EPOCHREALTIME - _prompt_ivan_timer) * 1000 ))
    psvar[11]=$(_prompt_ivan_format_time $elapsed_ms)
    unset _prompt_ivan_timer
  fi
}

